{
  "name": "krang-trader",
  "version": "0.1.0",
  "private": true,
  "description": "A risk-aware paper-trading agent for Recall competitions",
  "type": "module",
  "scripts": {
    "backtest": "tsx src/backtest-cli.ts data/synthetic-cycle.json",
    "backtest:stx": "tsx src/backtest-cli.ts data/stx-usd-daily-2026-10-28.json --last=90 --trades",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "market-data:stx": "tsx src/record-market-data-cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.2",
  "dependencies": {
    "dotenv": "^17.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  }
}
